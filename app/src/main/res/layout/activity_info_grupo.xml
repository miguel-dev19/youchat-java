<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InfoGrupoActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:fitsSystemWindows="true"
            android:theme="@style/AppTheme.AppBarOverlay">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/bar"
                app:toolbarId="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:titleEnabled="false"
                app:expandedTitleGravity="start|bottom"
                android:fitsSystemWindows="true"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <ImageView
                    android:id="@+id/iv_fondo_view_grupo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="?attr/colorPrimary"
                    app:layout_collapseMode="parallax" />

                <LinearLayout
                    android:id="@+id/fondo_grupo"
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:orientation="vertical"
                    android:paddingTop="190dp"
                    android:paddingBottom="40dp"
                    android:layout_gravity="center|top"
                    android:gravity="center">

                    <com.vanniktech.emoji.EmojiTextView
                        android:visibility="gone"
                        android:id="@+id/info_grupo_nombre1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textStyle="bold"
                        android:textColor="@color/texto_blanco_to_gris"
                        android:textSize="25sp"/>

                </LinearLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    app:title=""
                    app:layout_collapseMode="pin"
                    app:popupTheme="@style/AppTheme.PopupOverlay">

                    <cu.alexgi.youchat.views_GI.ImageViewBarGI
                        android:id="@+id/back"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:padding="8dp"
                        android:src="@drawable/arrow_left"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Descripción del grupo -->
                <com.vanniktech.emoji.EmojiTextView
                    android:id="@+id/info_grupo_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:gravity="center"
                    android:visibility="gone"/>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/darker_gray"
                    android:alpha="0.3"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Info de creación -->
                <TextView
                    android:id="@+id/info_grupo_creacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@android:color/darker_gray"
                    android:padding="8dp"
                    android:gravity="center"/>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/darker_gray"
                    android:alpha="0.3"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Título de miembros -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Miembros"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/info_grupo_cant_miembros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 miembros"
                        android:textSize="14sp"
                        android:textColor="@android:color/darker_gray"/>
                </LinearLayout>

                <!-- Lista de miembros -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/btn_agregar_miembro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/add_user"
                android:tint="?attr/colorAccent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Añadir miembros"
                android:textColor="?attr/colorAccent"
                android:textSize="16sp"
                android:paddingStart="16dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/info_grupo_lista_miembros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@android:color/darker_gray"
                    android:alpha="0.3"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Botón Salir del grupo -->
                <LinearLayout
                    android:id="@+id/btn_salir_grupo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/delete"
                        android:tint="@android:color/holo_red_dark"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Salir del grupo"
                        android:textColor="@android:color/holo_red_dark"
                        android:paddingStart="16dp"
                        android:textSize="16sp"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <cu.alexgi.youchat.views_GI.FABGI
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/fab_margin"
            app:layout_anchor="@id/app_bar"
            app:layout_anchorGravity="bottom|end"
            app:fabCustomSize="50dp"
            app:srcCompat="@drawable/chat"
            app:backgroundTint="?attr/colorAccent"
            app:tint="#fff"/>

        <cu.alexgi.youchat.CircleImageView
            android:id="@+id/img_grupo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/contacts"
            app:civ_border_width="3dp"
            app:civ_border_color="@color/fondo_blanco"
            app:civ_circle_background_color="@color/image_dialog_preview"
            android:layout_gravity="center|top"
            android:layout_marginTop="30dp"
            android:elevation="10dp"
            app:layout_behavior="com.zoonref.viewbehavior.SimpleViewBehavior"
            app:behavior_dependsOn="@+id/app_bar"
            app:behavior_dependType="y"
            app:behavior_dependTarget="-176dp"
            app:behavior_targetX="65dp"
            app:behavior_targetY="5dp"
            app:behavior_targetWidth="45dp"
            app:behavior_targetHeight="45dp"/>

        <cu.alexgi.youchat.views_GI.TextViewBarGI
            android:id="@+id/info_grupo_nombre2"
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"
            android:maxLines="1"
            android:elevation="10dp"
            android:layout_marginStart="122dp"
            android:layout_marginTop="-100dp"
            android:gravity="center_vertical"
            android:textColor="@color/texto_blanco_to_gris"
            android:alpha="0"
            app:layout_behavior="com.zoonref.viewbehavior.SimpleViewBehavior"
            app:behavior_dependsOn="@+id/app_bar"
            app:behavior_dependType="y"
            app:behavior_dependTarget="-180dp"
            app:behavior_targetY="0dp"
            app:behavior_targetAlpha="1"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>
