<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <cu.alexgi.youchat.CircleImageView
        android:id="@+id/foto_contacto"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/profile_white"
        app:civ_border_color="@android:color/transparent"
        app:civ_border_width="0dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/nombre_contacto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/correo_contacto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="correo@email.com"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/cb_seleccionar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"/>

</LinearLayout>
